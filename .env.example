FLASK_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
FLASK_COOKIE_SECURE=0
FLASK_DEBUG=1
PUBLIC_APP_URL=https://your-skillswap-domain.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=SkillSwap <notifications@your-domain.example>
VAPID_PUBLIC_KEY=your-browser-push-public-key
VAPID_PRIVATE_KEY=your-browser-push-private-key
VAPID_SUBJECT=mailto:admin@your-domain.example
